  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@repo/eslint-config": "*",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@types/react": "^18.2.61",
    "autoprefixer": "^10.4.18",
